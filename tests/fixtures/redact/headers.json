[
  {"name": "plain html", "input": {"Content-Type": "text/html; charset=utf-8", "Server": "nginx"},
   "expected": {"headers": {"content-type": "text/html; charset=utf-8", "server": "nginx"}, "cookie_names": []}},
  {"name": "authorization dropped", "input": {"Authorization": "Bearer abc.def", "Content-Type": "application/json"},
   "expected": {"headers": {"content-type": "application/json"}, "cookie_names": []}},
  {"name": "proxy authorization dropped", "input": {"Proxy-Authorization": "Basic dXNlcjpwYXNz", "Via": "1.1 proxy"},
   "expected": {"headers": {"via": "1.1 proxy"}, "cookie_names": []}},
  {"name": "set-cookie reduced to names", "input": {"Set-Cookie": "sessionid=s3cr3t; Path=/; HttpOnly", "Server": "gunicorn"},
   "expected": {"headers": {"server": "gunicorn"}, "cookie_names": ["sessionid"]}},
  {"name": "request cookie header names", "input": {"Cookie": "a=1; b=2;  c=3"},
   "expected": {"headers": {}, "cookie_names": ["a", "b", "c"]}},
  {"name": "merged set-cookie with expires comma", "input": {"set-cookie": "__cf_bm=xyz; Expires=Wed, 21 Oct 2026 07:28:00 GMT; Path=/, cf_clearance=abc; Path=/"},
   "expected": {"headers": {}, "cookie_names": ["__cf_bm", "cf_clearance"]}},
  {"name": "set-cookie on separate lines", "input": {"Set-Cookie": "datadome=AAA; Max-Age=31536000\ndd_s=1; Path=/"},
   "expected": {"headers": {}, "cookie_names": ["datadome", "dd_s"]}},
  {"name": "api key and auth token dropped", "input": {"X-Api-Key": "k", "X-Auth-Token": "t", "Content-Length": "123"},
   "expected": {"headers": {"content-length": "123"}, "cookie_names": []}},
  {"name": "csrf headers dropped", "input": {"X-CSRF-Token": "c", "X-XSRF-Token": "x", "ETag": "\"v1\""},
   "expected": {"headers": {"etag": "\"v1\""}, "cookie_names": []}},
  {"name": "regex sensitive names dropped", "input": {"X-Session-Id": "s", "X-Secret-Thing": "s", "X-Password": "p", "Retry-After": "120"},
   "expected": {"headers": {"retry-after": "120"}, "cookie_names": []}},
  {"name": "www-authenticate matches the auth pattern and is dropped", "input": {"WWW-Authenticate": "Basic realm=\"x\"", "Content-Type": "text/html"},
   "expected": {"headers": {"content-type": "text/html"}, "cookie_names": []}},
  {"name": "headers outside the allow-list dropped", "input": {"X-Request-Id": "abc", "Date": "Thu, 05 Nov 2026 14:12:03 GMT", "Server": "cloudflare"},
   "expected": {"headers": {"server": "cloudflare"}, "cookie_names": []}},
  {"name": "cloudflare vendor headers kept", "input": {"CF-RAY": "8a1b2c3d4e5f-LHR", "cf-mitigated": "challenge", "CF-Cache-Status": "DYNAMIC", "Server": "cloudflare"},
   "expected": {"headers": {"cf-ray": "8a1b2c3d4e5f-LHR", "cf-mitigated": "challenge", "cf-cache-status": "DYNAMIC", "server": "cloudflare"}, "cookie_names": []}},
  {"name": "datadome headers kept, cookie name only", "input": {"X-DataDome": "protected", "X-DataDome-CID": "AHrlqAAAAAMA", "Set-Cookie": "datadome=AbC; Path=/"},
   "expected": {"headers": {"x-datadome": "protected", "x-datadome-cid": "AHrlqAAAAAMA"}, "cookie_names": ["datadome"]}},
  {"name": "aws waf and cloudfront", "input": {"x-amzn-waf-action": "challenge", "X-Amz-Cf-Id": "abc==", "X-Cache": "Error from cloudfront"},
   "expected": {"headers": {"x-amzn-waf-action": "challenge", "x-amz-cf-id": "abc==", "x-cache": "Error from cloudfront"}, "cookie_names": []}},
  {"name": "location redacted", "input": {"Location": "https://user:pw@example.com/login?next=/a&token=abc"},
   "expected": {"headers": {"location": "https://example.com/login?next=/a&token=[redacted]"}, "cookie_names": []}},
  {"name": "location without secrets unchanged", "input": {"location": "/catalogue/page-2.html"},
   "expected": {"headers": {"location": "/catalogue/page-2.html"}, "cookie_names": []}},
  {"name": "duplicate case variants joined", "input": {"Vary": "Accept-Encoding", "vary": "Cookie"},
   "expected": {"headers": {"vary": "Accept-Encoding, Cookie"}, "cookie_names": []}},
  {"name": "empty", "input": {},
   "expected": {"headers": {}, "cookie_names": []}},
  {"name": "compression and caching kept", "input": {"Content-Encoding": "gzip", "Cache-Control": "max-age=60", "Last-Modified": "Wed, 04 Nov 2026 10:00:00 GMT", "Set-Cookie": "bad name=1"},
   "expected": {"headers": {"content-encoding": "gzip", "cache-control": "max-age=60", "last-modified": "Wed, 04 Nov 2026 10:00:00 GMT"}, "cookie_names": []}}
]
